# MongoDB
MONGODB_URI=mongodb://localhost:27017/onlypays-media

# AWS S3 / Object Storage
S3_BUCKET=onlypays-media
S3_REGION=ap-southeast-1
# Leave empty for real AWS; set to MinIO URL for local dev (e.g. http://localhost:9000)
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# CDN
CDN_BASE_URL=https://cdn.onlypays.com

# Pre-signed URL TTL (seconds) - 15 minutes
PRESIGNED_URL_TTL_SECONDS=900
